{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "generated_at", "timezone", "feeds", "week", "alerts", "tides", "days"],
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "generated_at": {"type": "string"},
    "timezone": {"const": "America/Costa_Rica"},
    "feeds": {
      "type": "object",
      "required": ["forecast", "marine", "imn", "tides"],
      "properties": {
        "forecast": {"$ref": "#/$defs/feed"},
        "marine": {"$ref": "#/$defs/feed"},
        "imn": {"$ref": "#/$defs/feed"},
        "tides": {"$ref": "#/$defs/feed"}
      }
    },
    "week": {
      "type": "object",
      "required": ["start", "end", "energy_q1_kj", "energy_median_kj", "energy_q3_kj", "energy_n", "calm_threshold_kj"]
    },
    "alerts": {"type": "array"},
    "tides": {"type": "array", "minItems": 4},
    "days": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": ["date", "sunrise", "sunset", "hours", "calm_windows", "tide_extrema", "wave_word", "sea"],
        "properties": {
          "hours": {"type": "array", "minItems": 24, "maxItems": 24}
        }
      }
    }
  },
  "$defs": {
    "feed": {
      "type": "object",
      "required": ["as_of", "ok", "source"],
      "properties": {
        "as_of": {"type": "string"},
        "ok": {"type": "boolean"},
        "source": {"type": "string"}
      }
    }
  }
}
